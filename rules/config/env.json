[
  {
    "id": "CFG001",
    "title": "SECRET_KEY hardcodeado en .env",
    "severity": "critical",
    "extensions": [".env"],
    "pattern": "(?i)^\\s*SECRET_KEY\\s*=\\s*.+"
  },
  {
    "id": "CFG002",
    "title": "DATABASE_URL con credenciales en .env",
    "severity": "high",
    "extensions": [".env"],
    "pattern": "(?i)^\\s*DATABASE_URL\\s*=\\s*(postgres|mysql|mongodb)://[^:]+:[^@]+@"
  },
  {
    "id": "CFG003",
    "title": "AWS_SECRET_ACCESS_KEY hardcodeado en .env",
    "severity": "critical",
    "extensions": [".env"],
    "pattern": "(?i)^\\s*AWS_SECRET_ACCESS_KEY\\s*=\\s*[A-Za-z0-9/+=]{40}"
  },
  {
    "id": "CFG004",
    "title": "API key hardcodeada en .env",
    "severity": "high",
    "extensions": [".env"],
    "pattern": "(?i)^\\s*(API_KEY|API_TOKEN|PRIVATE_KEY)\\s*=\\s*.{16,}"
  }
]
